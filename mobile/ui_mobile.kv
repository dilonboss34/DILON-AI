# mobile/ui_mobile.kv
#:kivy 2.0.0

<SleekButton@Button>:
    background_normal: ''
    background_color: 0.08, 0.08, 0.08, 1
    color: 0.8, 0.8, 0.8, 1
    font_size: '14sp'
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.15, 1
        Line:
            width: 1
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(5)

BoxLayout:
    orientation: 'vertical'
    padding: dp(20)
    spacing: dp(15)
    canvas.before:
        Color:
            rgba: 0.02, 0.02, 0.02, 1  # Sleek dark background
        Rectangle:
            pos: self.pos
            size: self.size
    
    # Header
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        
        Label:
            text: "J.A.R.V.I.S"
            font_name: 'Roboto' if platform == 'android' else 'Arial'
            font_size: '22sp'
            bold: True
            color: 0.9, 0.9, 0.9, 1  # Pure minimalist white
            size_hint_x: 0.7
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            
        Label:
            text: "ONLINE"
            font_size: '10sp'
            color: 0.4, 0.4, 0.4, 1  # Subtle gray
            size_hint_x: 0.3
            halign: 'right'
            valign: 'middle'
            text_size: self.size
    
    # Main interaction area
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        
        # Audio visualization area
        BoxLayout:
            size_hint_y: 0.35
            orientation: 'vertical'
            
            JarvisFace:
                id: jarvis_face
                size_hint_y: 0.85
                
            Label:
                id: state_label
                text: "INITIALISING"
                font_size: '11sp'
                color: 0.6, 0.6, 0.6, 1
                size_hint_y: 0.15
                halign: 'center'
    
    # Chat/log area
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.45
        
        ScrollView:
            GridLayout:
                id: chat_layout
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
    
    # Input area
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(10)
        
        TextInput:
            id: command_input
            hint_text: "Message..."
            multiline: False
            size_hint_x: 0.7
            background_normal: ''
            background_active: ''
            background_color: 0.05, 0.05, 0.05, 1
            foreground_color: 0.9, 0.9, 0.9, 1
            cursor_color: 0.9, 0.9, 0.9, 1
            padding: [dp(15), dp(15)]
            on_text_validate: app.on_submit()
            canvas.after:
                Color:
                    rgba: 0.2, 0.2, 0.2, 1
                Line:
                    width: 1
                    rounded_rectangle: self.x, self.y, self.width, self.height, dp(5)
        
        SleekButton:
            text: "🎤"
            size_hint_x: None
            width: dp(50)
            on_release: app.on_microphone()
        
        SleekButton:
            text: "📎"
            size_hint_x: None
            width: dp(50)
            on_release: app.on_file_attach()
    
    # Action buttons
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(10)
        
        SleekButton:
            text: "Search"
            on_release: app.do_web_search()
        
        SleekButton:
            text: "Weather"
            on_release: app.do_weather()
        
        SleekButton:
            text: "Camera"
            on_release: app.do_camera()